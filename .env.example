# ==============================================================================
# EchoSync AI - Master Environment Variables Template
# Copy this file to .env and replace placeholders with actual production values.
# NEVER COMMIT REAL SECRET KEYS OR CREDENTIALS TO GIT REPOSITORIES.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SYSTEM & SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Generate a secure 64-character random hex string: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_64_character_random_hex_string
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. FASTAPI BACKEND CONTROL PLANE GATEWAY
# ------------------------------------------------------------------------------
PROJECT_NAME="EchoSync AI"
VERSION="0.1.0"
API_V1_STR=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# 3. SUPABASE POSTGRESQL & PGVECTOR CONFIGURATION
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE R2 OBJECT STORAGE (S3 COMPATIBLE)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your-cloud-flare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=echosync-voice-samples
R2_PUBLIC_URL=https://pub-your-id.r2.dev

# ------------------------------------------------------------------------------
# 5. UPSTASH REDIS & CELERY TASK BROKER
# ------------------------------------------------------------------------------
REDIS_URL=rediss://default:your-redis-password@your-endpoint.upstash.io:6379
CELERY_BROKER_URL=rediss://default:your-redis-password@your-endpoint.upstash.io:6379
CELERY_RESULT_BACKEND=rediss://default:your-redis-password@your-endpoint.upstash.io:6379

# ------------------------------------------------------------------------------
# 6. HUGGING FACE INFERENCE ENGINE & SPACES
# ------------------------------------------------------------------------------
HF_INFERENCE_ENDPOINT_URL=https://your-space-name.hf.space/api/v1/inference
HF_API_TOKEN=hf_your_huggingface_access_token_placeholder

# ------------------------------------------------------------------------------
# 7. FRONTEND NEXT.JS PUBLIC CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/v1/stream
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
